# 数据库连接
DATABASE_URL=mysql+pymysql://user:password@host:port/aihub

# Sub2api 数据源（可选，用于 Token 用量看板）
SUB2API_POSTGRES_URL=postgresql+psycopg2://user:password@host:port/sub2api?sslmode=disable

# Web 对话流式缓存（Redis 5+）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
AIHUB_REDIS_PREFIX=aihub:chat:

# 本地 JWT 认证与默认管理员初始化
JWT_SECRET_KEY=change-this-to-a-strong-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Git 仓库配置
GIT_DOWNLOAD_TIMEOUT=180

# 前端与本地代理
VITE_BACKEND_URL=http://127.0.0.1:15174
VITE_API_TIMEOUT=10000
VITE_SKILL_IMPORT_TIMEOUT=120000

# 智能体工作区与 Runtime 执行隔离
AGENT_WORKSPACE_ROOT=./backend/agent_workspaces
AGENT_MAX_UPLOAD_FILES=10
AGENT_MAX_UPLOAD_FILE_BYTES=10485760
AGENT_MAX_UPLOAD_TOTAL_BYTES=20971520
AGENT_EXECUTION_LEASE_SECONDS=30
AGENT_EXECUTION_LEASE_POLL_SECONDS=0.5
AGENT_RUN_CONTROL_POLL_SECONDS=0.5
USER_WORKSPACE_ROOT=
USER_WORKSPACE_QUOTA_BYTES=10737418240
USER_WORKSPACE_USER_PREFIX=aihub_user_
AGENT_CREDENTIAL_ENCRYPTION_KEY=
AGENT_CREDENTIAL_KEY_VERSION=v1
MODEL_GATEWAY_BASE_URL=http://127.0.0.1:15174/api/model-gateway
MODEL_GATEWAY_CREDENTIAL_TTL_SECONDS=900
MODEL_GATEWAY_REQUEST_TIMEOUT_SECONDS=600

# Claude Code Runtime（container / native）
CLAUDE_CODE_SANDBOX_TYPE=container
AGENT_OPEN_CALL_ALLOW_QUERY=false

# MCP 出口策略（可选）
MCP_EGRESS_PROXY_URL=
MCP_ALLOWED_HOSTS=
MCP_ALLOW_PRIVATE_NETWORKS=false
MCP_STDIO_ALLOWED_COMMANDS=

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:15173

# 对话图片 OSS 存储（可选）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=aihub
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_PUBLIC_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_CHAT_IMAGE_PREFIX=tmp/chat-images
